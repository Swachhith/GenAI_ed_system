# Copy to .env. Pick ONE provider (or mix them with a "provider:" prefix on the model names).

# --- Option A: Claude (default) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# GENERATOR_MODEL=claude-sonnet-5-5
# EVALUATOR_MODEL=claude-opus-5-5
# ANTHROPIC_FALLBACKS=default      # server-side refusal fallback; set "off" to disable

# --- Option B: Gemini / Gemma (free tier available at aistudio.google.com) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GENERATOR_MODEL=gemini-3.5-flash-lite
# EVALUATOR_MODEL=gemini-3.5-flash-lite   # a stronger judge (e.g. gemini-3.5-flash) catches more
# EVAL_CONCURRENCY=2                      # free tier: 15 requests/min for flash-lite

# --- Option C: any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Together, DeepSeek, Ollama, vLLM...) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1    # omit for api.openai.com; Ollama: http://localhost:11434/v1
# GENERATOR_MODEL=...                             # required, no default
# EVALUATOR_MODEL=...
# OPENAI_STRUCTURED=auto                          # "text" forces JSON-in-text (servers without json_schema)

# --- Mixing providers: a cheap writer and a stronger judge from another provider ---
# GENERATOR_MODEL=gemini:gemini-3.5-flash-lite
# EVALUATOR_MODEL=anthropic:claude-opus-5-5

# --- Loop / evaluation / learning knobs ---
# MAX_RETRIES=2            # regenerations after the first draft (0-3); guarantees termination
# EVAL_CONCURRENCY=4       # parallel judge calls; use 1-2 on free-tier rate limits
# JUDGE_VOTES=1            # independent judge samples per check, majority per item (3 steadies small judges)
# LEARN_MIN_FAILURES=2     # failures of a check (across runs) before a guideline is learned
